{
  "name": "myself-documents",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "myself",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:myself.documentation.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "myself.documents.new",
        "title": "%new%",
        "category": "Documents",
        "icon": "$(new-file)"
      },
      {
        "command": "myself.documents.open",
        "title": "%open%",
        "category": "Documents",
        "icon": "$(book)"
      },
      {
        "command": "myself.documentation.search",
        "title": "%library.search%",
        "category": "Documentation",
        "icon": "$(search)"
      },
      {
        "command": "myself.documentation.import",
        "title": "%library.import%",
        "category": "Documentation",
        "icon": "$(add)"
      },
      {
        "command": "myself.documentation.remove",
        "title": "%library.remove%",
        "category": "Documentation",
        "icon": "$(trash)"
      },
      {
        "command": "myself.documentation.importFolder",
        "title": "%library.importFolder%",
        "category": "Documentation",
        "icon": "$(new-folder)"
      }
    ],
    "customEditors": [
      {
        "viewType": "myself.documents.editor",
        "displayName": "%editor%",
        "selector": [
          {
            "filenamePattern": "*.txt"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "myself.documents.new",
          "group": "file@2"
        }
      ],
      "explorer/context": [
        {
          "command": "myself.documents.new",
          "group": "navigation@30"
        },
        {
          "command": "myself.documents.open",
          "when": "resourceExtname == .txt && !explorerResourceIsFolder",
          "group": "navigation@31"
        }
      ],
      "editor/title": [
        {
          "command": "myself.documents.open",
          "when": "resourceExtname == .txt && activeCustomEditorId != myself.documents.editor",
          "group": "navigation@30"
        }
      ],
      "view/title": [
        {
          "command": "myself.documentation.search",
          "when": "view == myself.documentation.library",
          "group": "navigation@0"
        },
        {
          "command": "myself.documentation.import",
          "when": "view == myself.documentation.library",
          "group": "navigation@1"
        },
        {
          "command": "myself.documentation.importFolder",
          "when": "view == myself.documentation.library",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "myself.documentation.remove",
          "when": "view == myself.documentation.library && viewItem == importedDocumentation",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "myself.documentation.remove",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myselfDocumentation",
          "title": "%library.title%",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "myselfDocumentation": [
        {
          "id": "myself.documentation.library",
          "name": "%library.title%"
        }
      ]
    }
  },
  "scripts": {
    "compile": "pnpm -C ../.. exec tsc -p extensions/myself-documents && pnpm -C ../.. exec tsc -p extensions/myself-documents/webview && node esbuild.webview.mts",
    "test": "pnpm run compile && node --test test/*.test.cts",
    "test-webview": "node --test test/webview.test.cts"
  }
}
