{
  "name": "myself-language-servers",
  "publisher": "myself",
  "displayName": "Nerded Code Language Server Packages",
  "description": "Import and manage local ZIP packages containing macOS ARM64 language servers.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": { "vscode": "^1.146.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": false
  },
  "contributes": {
    "views": {
      "explorer": [
        { "id": "myself.languageServers.packages", "name": "Language Server Packages" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "myself.languageServers.packages",
        "contents": "Import a local ZIP containing a ready-to-use macOS ARM64 binary. Packages are shared across IDE profiles.\n[Import ZIP](command:myself.languageServers.importZip)"
      }
    ],
    "commands": [
      { "command": "myself.languageServers.importZip", "title": "Import Language Server ZIP", "icon": "$(add)" },
      { "command": "myself.languageServers.refresh", "title": "Refresh Language Server Packages", "icon": "$(refresh)" },
      { "command": "myself.languageServers.remove", "title": "Remove Language Server Package", "icon": "$(trash)" }
    ],
    "menus": {
      "view/title": [
        { "command": "myself.languageServers.importZip", "when": "view == myself.languageServers.packages", "group": "navigation@1" },
        { "command": "myself.languageServers.refresh", "when": "view == myself.languageServers.packages", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "myself.languageServers.remove", "when": "view == myself.languageServers.packages && viewItem == managedLanguageServerPackage", "group": "inline" }
      ],
      "commandPalette": [
        { "command": "myself.languageServers.remove", "when": "false" }
      ]
    }
  }
}
