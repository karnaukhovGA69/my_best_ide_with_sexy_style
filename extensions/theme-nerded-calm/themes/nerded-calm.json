		"typeParameter": "#C9B7F3",
		"namespace": "#C9B7F3",
		"function": "#B9DDFC",
		"method": "#B9DDFC",
		"macro": "#B9DDFC",
		"decorator": "#B9DDFC",
		"variable": "#E6E2DD",
