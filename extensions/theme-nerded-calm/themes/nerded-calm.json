	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#A39CA9"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#E8B4D9"
			}
		},
		{
			"name": "Operators and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#E6E2DD"
			}
		},
		{
			"name": "Language operators",
			"scope": [
				"keyword.operator.new",
				"keyword.operator.delete",
				"keyword.operator.expression",
				"keyword.operator.word"
			],
			"settings": {
				"foreground": "#E8B4D9"
			}
		},
		{
			"name": "Variables and parameters",
			"scope": [
				"variable",
				"support.variable",
				"entity.name.variable",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#E6E2DD"
			}
		},
		{
			"name": "Language constants",
			"scope": [
				"variable.language",
				"constant.language"
			],
			"settings": {
				"foreground": "#E8B4D9"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"support.constant.property-value",
				"support.constant.font-name",
				"support.constant.color"
			],
			"settings": {
				"foreground": "#D8C7F1"
			}
		},
		{
			"name": "Numbers and constants",
			"scope": [
				"constant.numeric",
				"constant.character",
				"constant.other",
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "#E6CB96"
			}
		},
		{
			"name": "Escapes and regular expressions",
			"scope": [
				"constant.character.escape",
				"string.regexp"
			],
			"settings": {
				"foreground": "#C9B7F3"
			}
		},
		{
			"name": "Types and namespaces",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#C9B7F3"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"entity.name.operator"
			],
			"settings": {
				"foreground": "#B9DDFC"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#E8B4D9"
			}
		},
		{
			"name": "Attributes and properties",
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"meta.property-name"
			],
			"settings": {
				"foreground": "#B9DDFC"
			}
		},
		{
			"name": "Embedded expressions",
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"string meta.interpolation"
			],
			"settings": {
				"foreground": "#E6E2DD"
			}
		},
		{
			"name": "Invalid code",
			"scope": [
				"invalid",
				"message.error"
			],
			"settings": {
				"foreground": "#F2A6A6"
			}
		},
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#B9DDFC",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Quotes",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#A39CA9"
			}
		},
		{
			"name": "Inline code",
			"scope": [
				"markup.inline.raw",
				"markup.raw"
			],
			"settings": {
				"foreground": "#D8C7F1"
			}
		},
		{
			"name": "Links",
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#C9B7F3",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Strikethrough",
			"scope": [
				"markup.strikethrough"
			],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Inserted lines",
			"scope": [
				"markup.inserted",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#A8D5BA"
			}
		},
		{
			"name": "Removed lines",
			"scope": [
				"markup.deleted",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#F2A6A6"
			}
		},
		{
			"name": "Changed lines",
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#E6CB96"
			}
		},
		{
			"name": "Diff headers",
			"scope": [
				"meta.diff.header",
				"meta.diff.range"
			],
			"settings": {
				"foreground": "#B9DDFC"
			}
		},
		{
			"name": "Log errors",
			"scope": [
				"token.error-token"
			],
			"settings": {
				"foreground": "#F2A6A6"
			}
		},
		{
			"name": "Log warnings",
			"scope": [
				"token.warn-token"
			],
			"settings": {
				"foreground": "#E6CB96"
			}
		},
		{
			"name": "Log info",
			"scope": [
				"token.info-token"
			],
			"settings": {
				"foreground": "#B9DDFC"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"comment": "#A39CA9",
		"keyword": "#E8B4D9",
		"operator": "#E6E2DD",
